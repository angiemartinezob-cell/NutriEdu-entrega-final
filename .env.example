# --- Servidor ---
NODE_ENV=development
PORT=3000
# postgres (por defecto) | memory (solo para pruebas rápidas, no persiste)
PERSISTENCE=postgres

# --- PostgreSQL (use DATABASE_URL o las variables separadas) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nutriedu_recetas
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
# DATABASE_URL=postgresql://usuario:clave@host:5432/nutriedu_recetas

# --- Seguridad ---
# Mínimo 32 caracteres. Cámbiela fuera del entorno local.
JWT_SECRET=cambie-esta-clave-local-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
BCRYPT_ROUNDS=10

{
  "name": "nutriedu-recetas-api",
  "version": "1.0.0",
  "description": "NutriEdu — Módulo de catálogo y recomendación personalizada de recetas (arquitectura hexagonal)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:memory": "tsx src/main.ts --memory",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/adapters/output/persistence/postgres/migrate.ts",
    "db:seed": "tsx src/infrastructure/adapters/output/persistence/postgres/seed.ts",
    "db:reset": "tsx src/infrastructure/adapters/output/persistence/postgres/seed.ts --reset",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:data": "tsx scripts/generateBenchmarkData.ts 500",
    "bench": "tsx scripts/benchmark.ts http://localhost:3000 300 10"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
